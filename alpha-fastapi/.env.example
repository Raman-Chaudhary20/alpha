# --- Slack bot (Socket Mode) ---
SLACK_APP_TOKEN=xapp-...
SLACK_BOT_TOKEN=xoxb-...

# --- Each person's Slack sign-in, so Alpha can read their DMs ---
# From the Slack app's Basic Information page.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Public https address of this server; register <PUBLIC_URL>/api/v1/slack/oauth/callback
# as a Redirect URL under OAuth & Permissions.
PUBLIC_URL=https://alpha.example.com
# Any long random string. Encrypts people's sign-ins; changing it means everyone signs in again.
TOKEN_KEY=

# --- Who may ask about private chats ---
# Slack user IDs, comma separated, on top of the workspace's own admins and owners.
ADMIN_USER_IDS=
# REST callers sending this in X-API-Key get answers from every conversation.
API_KEY=

# --- Amazon Bedrock (Alpha's AWS account) ---
AWS_REGION=us-east-1
# A profile from ~/.aws/config, or leave empty to use AWS_ACCESS_KEY_ID / an instance role.
AWS_PROFILE=alpha
BEDROCK_ANSWER_MODEL=us.anthropic.claude-sonnet-4-6
BEDROCK_DIGEST_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Sync ---
SLACK_SYNC_DAYS=90
SLACK_SYNC_MINUTES=2
MEMORY_BUILD_MINUTES=10
PORT=8000
DEBUG=false
